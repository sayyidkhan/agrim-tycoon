# Private llama.cpp OpenAI-compatible server running inside Zo Computer.
GEMMA_BASE_URL=http://127.0.0.1:8080/v1
GEMMA_MODEL=gemma-local
GEMMA_TIMEOUT_MS=6000

# Google Gemini API. Never expose this key through NEXT_PUBLIC_* variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=8000

# Public download target used by the web landing page.
NEXT_PUBLIC_MAC_DOWNLOAD_URL=/downloads/AgrimTycoon.dmg
