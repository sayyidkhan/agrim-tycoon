# Private llama.cpp OpenAI-compatible server running inside Zo Computer.
GEMMA_BASE_URL=http://127.0.0.1:8080/v1
GEMMA_MODEL=gemma-local
GEMMA_TIMEOUT_MS=6000

# Google Gemini API. Never expose this key through NEXT_PUBLIC_* variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=8000

# Desktop packaging only. Keep the accepted Gemma notice beside the model;
# `npm run desktop:build` stages both inside the signed macOS bundle.
# Optional: defaults to artifacts/llama-server-aarch64-apple-darwin, created
# by `npm run desktop:sidecar:build`.
AGRIM_LLAMA_SERVER_PATH=
# Optional override; the release build otherwise pins llama.cpp in source.
LLAMA_CPP_REVISION=
AGRIM_GEMMA_MODEL_PATH=/absolute/path/to/gemma.gguf
AGRIM_GEMMA_MODEL_SOURCE=https://example.com/model-release
AGRIM_GEMMA_MODEL_SHA256=<sha256-of-gemma.gguf>
AGRIM_GEMMA_NOTICE_PATH=/absolute/path/to/GEMMA_NOTICE.md

# Public download target used by the web landing page. Update this for every
# release, then set the same value in Vercel before deploying.
NEXT_PUBLIC_MAC_DOWNLOAD_URL=https://github.com/sayyidkhan/agrim-tycoon/releases/download/v0.1.0/AgrimTycoon-0.1.0-arm64.dmg
