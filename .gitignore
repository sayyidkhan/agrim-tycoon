# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/dist-desktop/
/src-tauri/target/
/src-tauri/gen/

# Desktop release inputs are deliberately local: the Gemma weights and bundled
# executable are large platform-specific artifacts, not source files.
/src-tauri/binaries/llama-server-*
/src-tauri/resources/models/*.gguf
/src-tauri/resources/models/GEMMA_MODEL_MANIFEST.json
/src-tauri/resources/licenses/GEMMA_NOTICE.md
/models/*.gguf
/artifacts/
/public/downloads/AgrimTycoon.dmg
/.wrangler/
/outputs/
/work/

# HyperFrames video render outputs and local preview caches.
/videos/*/.media/
/videos/*/.thumbnails/
/videos/*/renders/
